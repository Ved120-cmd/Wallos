# PostgreSQL connection for Wallos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wallos
DB_USER=wallos
DB_PASSWORD=
DB_SSLMODE=require
WALLOS_SETUP_TOKEN=replace-with-a-random-secret

# Alternatively use a complete PostgreSQL URL.
# DATABASE_URL=postgresql://wallos:password@localhost:5432/wallos?sslmode=require
